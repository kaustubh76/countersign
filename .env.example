# Copy to .env (gitignored) and fill in. Never commit .env.

# ── RPC ──────────────────────────────────────────────────────────────────────
# Default public endpoint. It serves historical txs and receipts, but not eth_getLogs history.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Optional archive-capable endpoint (a keyed provider). It is only needed for fork tests,
# because non-archive forks of BSC die within ~1 minute at 0.45 s blocks.
BSC_ARCHIVE_RPC_URL=

# ── Keys (fresh EOAs generated locally; fund the deployer with ~0.005 BNB) ───
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Red-Line Check attester: signs attest() txs from the local CLI only, never from a server
ATTESTER_PRIVATE_KEY=
ATTESTER_ADDRESS=

# ── Verification ─────────────────────────────────────────────────────────────
# Etherscan API V2 key. It is used for BscScan verification and for reading verified source.
ETHERSCAN_API_KEY=

# ── Fixed addresses (BSC mainnet, chain 56) ──────────────────────────────────
AGENT_ID_ADDRESS=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
