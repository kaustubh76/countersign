{
  "name": "countersign",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:contracts": "cd contracts && forge test",
    "build:skill": "pnpm --filter @countersign/companion build:skill",
    "attest": "pnpm --filter @countersign/companion attest"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
